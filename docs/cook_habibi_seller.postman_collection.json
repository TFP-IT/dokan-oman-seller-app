              }
            ],
            "url": {
              "raw": "{{base_url}}/seller/cook-habibi/device",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "seller",
                "cook-habibi",
                "device"
              ]
            },
            "description": "Saves the FCM token for this cook.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_token\": \"{{device_token}}\",\n  \"device_type\": \"android\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
