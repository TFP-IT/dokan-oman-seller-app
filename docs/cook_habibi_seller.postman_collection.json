{
  "info": {
    "name": "Cook Habibi – Seller (cook) API",
    "description": "Cook (seller) app API, production version. Contract: docs/cook_habibi/cook_habibi_api.md (§14). Pick the environment, run 'Sign in (cook)' first; it saves cook_token. Order and story ids are saved by the creating requests or set by hand in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{cook_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 · Sign in and application",
      "description": "Works before approval too. The token is a seller token (cook ability, expires after 30 days).",
      "item": [
        {
          "name": "Sign in (cook)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "System-Key",
                "value": "{{system_key}}"
              },
              {
                "key": "App-Language",
                "value": "{{app_language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Sends user_type=seller. Saves cook_token. 10 failed sign-ins in a minute return 429.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_by\": \"email\",\n  \"email\": \"{{cook_email}}\",\n  \"password\": \"{{cook_password}}\",\n  \"user_type\": \"seller\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": "\nconst j = pm.response.json();\nif (j.access_token) {\n  pm.environment.set('cook_token', j.access_token);\n}\npm.test('login returns a token', () => pm.expect(j.access_token).to.be.a('string'));\n"
              }
            }
          ]
        },
        {
          "name": "Application status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "System-Key",
                "value": "{{system_key}}"
              },
              {
                "key": "App-Language",
                "value": "{{app_language}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/seller/cook-habibi/application",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "seller",
                "cook-habibi",
                "application"
              ]
            },
            "description": "pending / approved / rejected, rejection_reason, can_resubmit, missing_checks."
          },
          "response": []
        },
        {
          "name": "Resubmit application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "System-Key",
                "value": "{{system_key}}"
              },
              {
                "key": "App-Language",
                "value": "{{app_language}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/seller/cook-habibi/application/resubmit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "seller",
                "cook-habibi",
                "application",
                "resubmit"
              ]
            },
            "description": "Only when rejected. 422 otherwise."
          },
          "response": []
        },
        {
          "name": "Register push device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
