              },
              {
                "key": "App-Language",
                "value": "{{app_language}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/seller/cook-habibi/device",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "seller",
                "cook-habibi",
                "device"
              ]
            },
            "description": "Call on sign-out."
          },
          "response": []
        }
      ]
    },
